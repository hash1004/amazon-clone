# Postgres connection string (self-hosted Postgres container in production, local Docker in dev)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST="true"

# Public URL used for metadata / Open Graph links (optional — defaults to the live domain)
NEXT_PUBLIC_SITE_URL="https://stillcoffeeandco.svdistributor.com"
